; Engine configuration file.
; Godot 4.7.2 stable.

config_version=5

[application]

config/name="Night Shift"
config/description="Night Shift / Ночная смена — narrative hospital management. Vertical slice."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Screen="*res://code/core/screen.gd"
Assets="*res://code/core/assets.gd"
Audio="*res://code/core/audio.gd"
Game="*res://code/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.05, 1)
